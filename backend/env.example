# Copia este archivo como ".env" (con el punto) y completa los valores.
# El archivo .env NO se sube a GitHub porque tiene claves privadas.

# Cadena de conexión de Neon (pídesela por mensaje privado a quien creó el proyecto).
DATABASE_URL=pega-aqui-la-cadena-de-conexion-de-neon
# Puerto donde corre la API
PORT=4000

# Clave para firmar los tokens de sesión (cualquier texto largo y secreto)
JWT_SECRET=escribe-aqui-una-clave-larga-y-secreta 

# ── Pagos con Stripe ──
# Claves del MODO DE PRUEBA (https://dashboard.stripe.com/test/apikeys). Cada integrante usa las suyas.
STRIPE_SECRET_KEY=sk_test_pega-aqui-tu-clave
# Secreto del webhook: lo imprime "stripe listen --forward-to localhost:4000/api/pagos/webhook"
STRIPE_WEBHOOK_SECRET=whsec_pega-aqui-el-secreto
# Dirección de la página: a ella vuelve Stripe después de pagar
FRONTEND_URL=http://localhost:8443